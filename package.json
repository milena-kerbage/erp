{
  "name": "milena-kerbage-erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "panda codegen",
    "dev": "next dev",
    "build": "panda codegen && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "auth:create-user": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/create-auth-user.mjs",
    "erp:authorize-admin": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/authorize-erp-admin.mjs",
    "test:config": "node --experimental-strip-types --test tests/supabase-config.test.mjs",
    "env:set-database-url": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/set-database-url.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/apply-migrations.mjs",
    "db:crud": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-erp-crud.mjs",
    "db:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-database.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mjs",
    "test:auth:http": "node --experimental-strip-types tests/auth-http.mjs",
    "test:whatsapp": "node --experimental-strip-types --test tests/whatsapp.test.mjs tests/meta-deletion.test.mjs",
    "test:integrations": "node --experimental-strip-types --test tests/integration-manager.test.mjs",
    "test:erp": "node --experimental-strip-types --test tests/erp-core.test.mjs tests/erp-access.test.mjs",
    "test:erp:postgres": "ERP_TEST_POSTGRES=1 node --experimental-strip-types --test tests/erp-core.test.mjs",
    "test:whatsapp:http": "node --experimental-strip-types tests/whatsapp-http.mjs",
    "test:db-check": "node --experimental-strip-types tests/database-check.mjs",
    "test:db-migrate": "node --experimental-strip-types tests/apply-migrations.mjs",
    "test:db-crud": "node --experimental-strip-types tests/erp-crud-check.mjs",
    "test:postgres": "node --experimental-strip-types tests/postgres.mjs",
    "meta:deletion": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/meta-deletion.mjs",
    "whatsapp:check": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/check-whatsapp.mjs",
    "whatsapp:maintenance": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/whatsapp-maintenance.mjs",
    "test:loja": "node --experimental-strip-types --test 'tests/loja/**/*.test.mjs'",
    "test:avaliacoes": "node --experimental-strip-types --test tests/avaliacoes.test.mjs",
    "test:avaliacoes:postgres": "AVALIACOES_TEST_POSTGRES=1 node --experimental-strip-types --test tests/avaliacoes.test.mjs"
  },
  "dependencies": {
    "@dicebear/core": "^10.7.0",
    "@dicebear/styles": "^10.6.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "^2.5.0",
    "@pandacss/preset-panda": "^2.5.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "schema-dts": "^2.1.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
