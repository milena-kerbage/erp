# Copie para .env.local. Nenhum segredo deve usar NEXT_PUBLIC_ ou ser versionado.
# Produção exige HTTPS e AUTH_REQUIRE_LOGIN=true.
AUTH_ORIGIN=https://erp.ateliemilenakerbage.com.br
AUTH_REQUIRE_LOGIN=true
# Banco do ERP = projeto Supabase (também em desenvolvimento local; não há banco local de exemplo).
# DATABASE_URL é SECRETA e vai só em .env.local (use `npm run env:set-database-url`: prompt oculto). Em desenvolvimento
# basta a conexão direta postgresql://postgres:<senha>@db.<project-id>.supabase.co:5432/postgres (exige IPv6); na Vercel
# use o Transaction Pooler (porta 6543, painel Supabase > Connect). Nunca a coloque em código, documentação, logs, chat ou em variáveis NEXT_PUBLIC_.
# O app NÃO usa a anon/publishable key nem a service_role key: o servidor fala com o PostgreSQL pelos
# esquemas privados erp_* (fora da Data API). Não configure essas chaves a menos que surja um uso real.
DATABASE_URL=
# Certificado CA PEM do painel Supabase (Database Settings > SSL Configuration); o Supabase usa CA própria, então é
# necessário. Em .env.local fica entre aspas, numa linha, com \n no lugar das quebras.
# TLS sempre valida servidor; não desabilite verificação em produção.
DATABASE_SSL_CA=
# Conexões simultâneas por instância (1 a 10; padrão 1, ideal para serverless/pooler de transações). Em desenvolvimento com
# banco remoto distante (cada ida e volta custa ~100 ms), 4 paraleliza as requisições da tela.
DATABASE_POOL_MAX=
# Identificadores PÚBLICOS do projeto Supabase. O app recusa DATABASE_URL de outro projeto
# (usuário do pooler precisa ser postgres.<project-id>). SUPABASE_URL deve ser https://<project-id>.supabase.co.
SUPABASE_PROJECT_ID=raexyjyeiuhahhzhaagu
SUPABASE_URL=https://raexyjyeiuhahhzhaagu.supabase.co
# Escolha explícita pelo SQLite local em .data (AUTH_DB_PATH, ERP_DB_PATH, WHATSAPP_DB_PATH). Só para testes
# isolados: sem DATABASE_URL e sem este valor o app mostra erro de configuração em vez de usar dados locais.
ALLOW_LOCAL_SQLITE=
# Bootstrap único: 32 bytes aleatórios em base64 para AES-256-GCM das credenciais salvas pelo gestor.
# Preserve a mesma chave entre deployments; trocar sem migrar torna segredos ilegíveis.
INTEGRATION_ENCRYPTION_KEY=
# Opcional: administradores do ERP já administram integrações. Lista de e-mails com perfil de gestão também autorizados, separados por vírgula.
INTEGRATION_MANAGER_EMAILS=
# Bootstrap de administradores do ERP: lista de e-mails de contas reais, antes do primeiro login.
# Depois da criação do papel persistido, gerencie a equipe pela interface.
ERP_ADMIN_EMAILS=
# Hosts HTTPS de webhooks explicitamente autorizados para entrega; separados por vírgula.
ERP_WEBHOOK_ALLOWED_HOSTS=
# Recuperação de senha existente (opcional, SMTP com TLS obrigatório).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Integração de uma única empresa / WABA. Consulte docs/whatsapp-meta.md.
# Selecione explicitamente uma versão suportada no painel Meta; não existe fallback latest.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
# App Secret único: META_APP_SECRET é primário para WhatsApp e callback de exclusão Meta.
META_APP_SECRET=
META_APP_ID=
# OAuth opcional: habilite somente após configurar Facebook Login, URI e permissões reais do app.
META_OAUTH_ENABLED=false
# Alias legado opcional, usado apenas se META_APP_SECRET estiver vazio.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PUBLIC_BASE_URL=
# PUBLIC_BASE_URL é a origem pública principal compartilhada com os callbacks Meta (prioridade sobre WHATSAPP_PUBLIC_BASE_URL).
PUBLIC_BASE_URL=https://erp.ateliemilenakerbage.com.br
WHATSAPP_RETENTION_DAYS=90
# Chave aleatória estável >=32 caracteres, distinta do App Secret. Rotação requer migração da supressão.
WHATSAPP_SUPPRESSION_SECRET=

# Dados reais do controlador para as páginas públicas; preencha antes de publicar.
LEGAL_ENTITY_NAME=Milena Cavalcante Kerbage
LEGAL_CNPJ=13.592.162/0001-08
LEGAL_ADDRESS=Rua Professor Heraclito, 233, Vicente Pinzon, Fortaleza - CE, CEP 60181-245
LEGAL_PRIVACY_EMAIL=milenakerbageatelie@gmail.com
LEGAL_SUPPORT_EMAIL=milenakerbageatelie@gmail.com
LEGAL_WHATSAPP_PHONE=

# --- Loja (e-commerce em www. e no domínio principal; ERP em erp.) ---
# Hosts extras que abrem a LOJA (separados por vírgula), além de ateliemilenakerbage.com.br, www.ateliemilenakerbage.com.br,
# www.localhost e loja.localhost. Qualquer outro host abre o ERP. Ex.: um domínio de prévia da Vercel só para a loja.
LOJA_HOSTS=
# Opcional: chave do IndexNow (8 a 128 letras, números e hífen), servida em https://www.<domínio>/<chave>.txt.
INDEXNOW_CHAVE=
# Avaliações da loja: com `npm run dev` ligado a um DATABASE_URL remoto, o envio é só simulado (nada é gravado).
# true = gravar de propósito nesse cenário. Em produção (NODE_ENV=production) a gravação é sempre real.
AVALIACOES_GRAVAR_EM_DESENVOLVIMENTO=
